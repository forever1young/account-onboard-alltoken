# HTTP
PORT=8080

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@postgres:5432/account_onboard?sslmode=disable

# Redis (deliver queue, oauth state cache)
REDIS_URL=redis://:password@redis:6379/0

# Credential encryption key (never rotate after accounts exist)
CREDENTIAL_ENCRYPTION_KEY=

# Claude.ai OAuth client
CLAUDE_OAUTH_CLIENT_ID=
CLAUDE_OAUTH_REDIRECT_URI=

# Export API (consumed only by account-pool, never the other way)
EXPORT_API_KEY=
EXPORT_API_ALLOWED_IPS=
